# Copy to .env (local dev) or .env.production (deploy) and fill in real values.
# Selected at runtime by APP_ENV (default: development).

# ── 文字/对话 LLM（与运营商解耦，换厂只改值不改名）──
# 阿里云百炼 OpenAI 兼容接口；GLM / Qwen / DeepSeek 可只换模型名。
CHAT_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=glm-5.2
CHAT_THINKING=false

# ── 图片生成（火山方舟 Agent Plan Seedream）──
# 视觉模型不支持 Auto/控制台切换；成本高，默认 false 不生成配图
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
IMAGE_MODEL=doubao-seedream-5.0-lite
IMAGE_SIZE=2560x1440
IMAGE_ENABLED=false

# ── 语音 ASR + TTS（阿里云百炼）──
VOICE_API_KEY=
VOICE_PROVIDER=dashscope
VOICE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VOICE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
VOICE_ASR_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
TTS_LANGUAGE=English
ASR_MODEL=qwen3-asr-flash

# ── 发音评测（默认关闭；腾讯智聆新版）──
PRONUNCIATION_ENABLED=false
PRONUNCIATION_PROVIDER=tencent
PRONUNCIATION_APP_ID=
PRONUNCIATION_SECRET_ID=
PRONUNCIATION_SECRET_KEY=
PRONUNCIATION_WS_URL=wss://soe.cloud.tencent.com/soe/api
PRONUNCIATION_SCORE_COEFF=2.0
PRONUNCIATION_ISSUE_THRESHOLD=80
PRONUNCIATION_MAX_ISSUES=3

# ── 视频生成（当前产品未接 UI；Medium 套餐暂不支持 Seedance 2.0 系列）──
VIDEO_API_KEY=
VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VIDEO_MODEL=doubao-seedance-1.5-pro
VIDEO_ENABLED=false
VIDEO_POLL_INTERVAL_SECONDS=5
VIDEO_POLL_TIMEOUT_SECONDS=180
# 可选但 Medium 不要默认用：doubao-seedance-2.0 / doubao-seedance-2.0-fast

# DB：本地/生产是不同的服务器，库名都用 speakup（靠连接区分环境，不加 -dev/-prod）
MONGO_URI=mongodb://localhost:27017/speakup
PORT=3001

# Alibaba Cloud OSS：dev/prod 共用阿里云，靠桶名区分（dev=speakup-dev，prod=speakup-prod）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=speakup-dev

# ── Langfuse trace（LLM 观测/评测；留空 = 整体关闭，不影响任何功能）──
# 自托管在 services 机 k3s（langfuse ns）。本地两种连法（详见 docs/langfuse.md）：
# 1) 公网 NodePort：LANGFUSE_HOST=http://<services 机公网 IP>:30030（明文 HTTP，自行权衡）
# 2) SSH 转发：ssh -L 3000:<langfuse-web ClusterIP>:3000 <services 机>，再填 http://127.0.0.1:3000
# eval 调用（link_to 带 eval_task）会打 environment=eval，和线上流量隔开
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
