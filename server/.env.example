# Copy to .env (local dev) or .env.production (deploy) and fill in real values.
# Selected at runtime by APP_ENV (default: development).

# ── 文字/对话 LLM（与运营商解耦，换厂只改值不改名）──
# 火山方舟 Agent Plan：OpenAI 兼容 base 必须走 /api/plan/v3
CHAT_API_KEY=
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
CHAT_MODEL=glm-5.2
CHAT_THINKING=false

# ── 图片生成（火山方舟 Agent Plan Seedream）──
# 视觉模型不支持 Auto/控制台切换；成本高，默认 false 不生成配图
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
IMAGE_MODEL=doubao-seedream-5.0-lite
IMAGE_SIZE=2560x1440
IMAGE_ENABLED=false

# ── 语音 ASR + TTS（火山 openspeech Agent Plan 专属 URL）──
VOICE_API_KEY=
VOICE_APP_KEY=plan
VOICE_BASE_URL=https://openspeech.bytedance.com/api/v3/plan
VOICE_WS_BASE_URL=wss://openspeech.bytedance.com/api/v3/plan
VOICE_TTS_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
VOICE_ASR_URL=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
TTS_RESOURCE_ID=seed-tts-2.0
TTS_MODEL=seed-tts-2.0
TTS_VOICE=zh_female_vv_uranus_bigtts
ASR_RESOURCE_ID=volc.seedasr.sauc.duration
ASR_MODEL=bigmodel

# ── 视频生成（当前产品未接 UI；Medium 套餐暂不支持 Seedance 2.0 系列）──
VIDEO_API_KEY=
VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VIDEO_MODEL=doubao-seedance-1.5-pro
VIDEO_ENABLED=false
VIDEO_POLL_INTERVAL_SECONDS=5
VIDEO_POLL_TIMEOUT_SECONDS=180
# 可选但 Medium 不要默认用：doubao-seedance-2.0 / doubao-seedance-2.0-fast

# DB：本地/生产是不同的服务器，库名都用 speakup（靠连接区分环境，不加 -dev/-prod）
MONGO_URI=mongodb://localhost:27017/speakup
PORT=3001

# Alibaba Cloud OSS：dev/prod 共用阿里云，靠桶名区分（dev=speakup-dev，prod=speakup-prod）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=speakup-dev
