# Copy to .env (local dev) or .env.production (deploy) and fill in real values.
# Selected at runtime by APP_ENV (default: development).

# ── 文字/对话 LLM（与运营商解耦，换厂只改值不改名）──
# 现接火山方舟 Coding Plan：base 必须走 /api/coding/v3，模型用短名 glm-5.2，开 thinking
CHAT_API_KEY=
CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
CHAT_MODEL=glm-5.2
CHAT_THINKING=true

# ── 图片生成（现阿里云通义万相）──
# 成本高，默认 false 不生成配图（场景题按无图渲染）；要恢复设 true 并填 key
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com
IMAGE_MODEL=wanx2.1-t2i-turbo
IMAGE_ENABLED=false

# ── 语音 ASR + TTS（现阿里云 DashScope；与图片同厂但独立配置）──
VOICE_API_KEY=
VOICE_BASE_URL=https://dashscope.aliyuncs.com
# ASR_MODEL=qwen3-asr-flash
# TTS_MODEL=cosyvoice-v2
# TTS_VOICE=longxiaochun_v2

# DB：本地/生产是不同的服务器，库名都用 speakup（靠连接区分环境，不加 -dev/-prod）
MONGO_URI=mongodb://localhost:27017/speakup
PORT=3001

# Alibaba Cloud OSS：dev/prod 共用阿里云，靠桶名区分（dev=speakup-dev，prod=speakup-prod）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=speakup-dev
